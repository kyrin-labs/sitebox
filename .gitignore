node_modules/
.env
*.log
.DS_Store

# Runtime config temp files (atomic writes)
dashboard/data/*.tmp

# Runtime PID state
dashboard/data/.pids.json

# Secrets: token hashes and browser sessions. Never in a public repo, never in history.
dashboard/data/tokens.json
dashboard/data/sessions.json
dashboard/data/audit.log

# Ignore all sites EXCEPT the two examples
# Any new site added to sites/ will NOT be tracked
sites/*
!sites/example-notes/
!sites/example-notes/**
!sites/example-clock/
!sites/example-clock/**

# Rust build output
engine/target/

# Supervisor logs and pipeline fingerprints are runtime state
logs/
.sitebox/
sites/*/.sitebox/

# Studio runtime state: settings (contains the API key), threads, patches,
# snapshots and screenshots. Never source.
dashboard/data/studio/
