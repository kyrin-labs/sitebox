# Copy to .env; docker compose reads it for the sitebox service.

# AI gateway used by Sols. Values here override dashboard/data/studio/settings.json,
# and AI_API_KEY is never copied into that file.
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=model-name
AI_API_KEY=sk-...

# Web search for Sols (SearXNG). Must answer /search?q=...&format=json.
SEARXNG_URL=http://127.0.0.1:8899

# Internal hosts Sols may fetch, e.g. a reference site on the LAN.
# Comma separated; host or host:port. Everything else keeps the SSRF guard.
# SOLS_FETCH_ALLOW=127.0.0.1:4610

# Optional: restrict engines, comma separated (google,bing,duckduckgo,wikipedia).
# Empty uses the SearXNG default set.
SEARXNG_ENGINES=
