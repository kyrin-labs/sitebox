#!/bin/sh
# SiteBox — dashboard/data/sites.json is runtime state.
# Deployed servers update it, but those updates must never be committed.
# Only the two bundled example sites belong in the repository copy.
if git diff --cached --name-only --diff-filter=ACMR | grep -qx 'dashboard/data/sites.json'; then
  echo ""
  echo "COMMIT BLOCKED: dashboard/data/sites.json is runtime state."
  echo ""
  echo "This file is rewritten by the dashboard at runtime (site add/delete,"
  echo "auto-detect). The copy in git must only ever contain the two example"
  echo "sites: example-notes and example-clock."
  echo ""
  echo "To unstage it:   git restore --staged dashboard/data/sites.json"
  echo "To restore it:   git checkout -- dashboard/data/sites.json"
  echo "Do not use --no-verify to bypass this check."
  echo ""
  exit 1
fi
exit 0
